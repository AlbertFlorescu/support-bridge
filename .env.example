# Live mode reads environment variables; this file is a template, not auto-loaded.
# Copy to .env, edit locally, then in bash: set -a; source .env; set +a
# Use a private GitHub sandbox repository and Zendesk sandbox tickets first.
BRIDGE_GITHUB_REPOSITORY=your-org/private-escalations
BRIDGE_GITHUB_TOKEN=replace-me
BRIDGE_ZENDESK_SUBDOMAIN=your-sandbox
# OAuth bearer access tokens are recommended for new deployments.
BRIDGE_ZENDESK_AUTH=oauth
BRIDGE_ZENDESK_TOKEN_FILE=/absolute/private/path/zendesk-token
# The file contains an OAuth access token, never the OAuth client secret.
# Issue manually with tools/oauth/issue-zendesk-token.php; there is no automatic refresh.
# After replacing the access-token file, restart credential-reading application processes.
# The isolated Compose live demo imports both access tokens through its credentials service.
# See docs/LIVE_DEMO.md; do not put credential values in the Compose metadata env file.
# Legacy API-token authentication remains supported where the account permits it:
# BRIDGE_ZENDESK_AUTH=api-token
# BRIDGE_ZENDESK_EMAIL=agent@example.com
# BRIDGE_ZENDESK_TOKEN_FILE=/absolute/private/path/legacy-zendesk-token

# Local operator HTTP API; generate a random value of at least 32 characters.
# Use only on localhost or behind an authenticated TLS reverse proxy.
BRIDGE_API_TOKEN=replace-with-a-random-value-at-least-32-characters
# BRIDGE_MODE=local
# BRIDGE_HOME=/absolute/path/to/private/state

# Separate read-only Prometheus scrape credential; must differ from the operator token.
BRIDGE_METRICS_TOKEN=replace-with-a-different-random-value-at-least-32-characters
