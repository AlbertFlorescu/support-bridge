{
  "uid": "supportbridge-overview",
  "title": "Support Bridge — Demo cases",
  "description": "The three linked demonstration cases and their last observed bridge workflow. Manual sweeps, stored evidence and an explicit review gate; no simulated traffic or inferred vendor freshness.",
  "tags": [
    "support-bridge",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics connection",
      "description": "Connected means Prometheus can scrape the bridge. It does not verify vendor credentials or current vendor state.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"support_bridge\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Connected",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Actual linked pairs",
      "description": "Actual stored link count across the deployment. The case table below shows the three named demo cases; missing cases remain visible and additional links increase this total.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(support_bridge_pairs)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              },
              {
                "color": "orange",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Operator attention",
      "description": "Stored approval waits, conflicts and dead work across the deployment. A count is a signal to inspect evidence, not authority to approve or select a source.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(support_bridge_pairs{status=~\"conflict|dead|awaiting_approval\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "The three demonstration cases",
      "description": "Stored evidence for CSV export, webhook delivery and SSO sign-in. Synced and resolution describe the last verified bridge operation, not a fresh vendor read. Manual sweeps can leave older observations. Missing links and unknown states are explicit; no approval can be supplied here.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_demo_case_status",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "support_bridge_demo_case_resolution",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "support_bridge_demo_case_pending_plan",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "support_bridge_demo_case_attempts",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "1000 * support_bridge_demo_case_last_success_timestamp_seconds",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "case",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "case",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "case": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "case": "Case",
              "Value #A": "Workflow state",
              "Value #B": "Last verified resolution",
              "Value #C": "Pending plan",
              "Value #D": "Failed attempts",
              "Value #E": "Last verified convergence"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Case",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not observed",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Case"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Workflow state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Not linked",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Ready for sweep",
                        "color": "blue"
                      },
                      "2": {
                        "text": "Synced",
                        "color": "green"
                      },
                      "3": {
                        "text": "Awaiting approval",
                        "color": "orange"
                      },
                      "4": {
                        "text": "Conflict",
                        "color": "red"
                      },
                      "5": {
                        "text": "Retry scheduled",
                        "color": "yellow"
                      },
                      "6": {
                        "text": "Needs intervention",
                        "color": "red"
                      },
                      "7": {
                        "text": "Unknown stored state",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last verified resolution"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No verified baseline",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Open",
                        "color": "blue"
                      },
                      "2": {
                        "text": "Resolved",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending plan"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "None recorded",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed attempts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last verified convergence"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "noValue",
                "value": "Never verified"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Never verified",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 250
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Observed case workflow history",
      "description": "Sampled stored workflow states for these cases since case metrics were introduced. Earlier history is not backfilled. Scrape gaps are not inferred success, and short transitions can occur between samples. This is not a live vendor event stream.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_demo_case_status",
          "legendFormat": "{{case}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not observed",
          "color": {
          "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not linked",
                  "color": "gray"
                },
                "1": {
                  "text": "Ready for sweep",
                  "color": "blue"
                },
                "2": {
                  "text": "Synced",
                  "color": "green"
                },
                "3": {
                  "text": "Awaiting approval",
                  "color": "orange"
                },
                "4": {
                  "text": "Conflict",
                  "color": "red"
                },
                "5": {
                  "text": "Retry scheduled",
                  "color": "yellow"
                },
                "6": {
                  "text": "Needs intervention",
                  "color": "red"
                },
                "7": {
                  "text": "Unknown stored state",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.75,
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
