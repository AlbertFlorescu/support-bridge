{
  "uid": "supportbridge-overview",
  "title": "Support Bridge \u2014 linked escalations",
  "description": "Every linked escalation with last verified subjects, fixed source links, separate conversation delivery counts and sampled workflow history. Monitoring reads stored evidence without vendor access or approval.",
  "tags": [
    "support-bridge",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 12,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Metrics connection",
      "description": "Connected means Prometheus can scrape the bridge. It does not verify vendor credentials or current vendor state.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"support_bridge\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Connected",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Actual linked pairs",
      "description": "Actual stored link count across the deployment. The case table below shows the three named demo cases; missing cases remain visible and additional links increase this total.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_linked_pairs",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [],
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Operator attention",
      "description": "Stored pair, intake and comment concerns. Every term is aggregated to the same label set; zero means no stored concerns, while missing data stays unknown. Counts can overlap and never authorize a write.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(support_bridge_pairs{status=~\"conflict|dead|awaiting_approval\"}) + sum(support_bridge_intake_records{status=~\"creating|uncertain|blocked\"}) + sum(support_bridge_comment_deliveries{status=~\"sending|uncertain|blocked\"}) + sum(support_bridge_comment_stream_errors) + sum(support_bridge_comment_privacy_hold) + sum(support_bridge_note_deliveries{status=~\"sending|uncertain|blocked\"}) + sum(support_bridge_note_stream_errors)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "Not observed",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No stored concerns",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "All linked ticket and issue pairs",
      "description": "Every stored link. Ticket subject is the last verified common title, not a fresh provider read or an unapproved target. Click record numbers to open the configured Zendesk/GitHub source in a new tab. Unknown subjects remain explicit. Subjects and destination URLs are fetched through the authenticated read-only records datasource, never Prometheus labels.",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "supportbridge-records"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "supportbridge-records"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "/monitoring/pairs",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "format": "table",
          "root_selector": "items",
          "columns": [
            {
              "selector": "zendesk_ticket",
              "text": "Zendesk ticket",
              "type": "string"
            },
            {
              "selector": "github_issue",
              "text": "GitHub issue",
              "type": "string"
            },
            {
              "selector": "subject",
              "text": "Ticket subject",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "Workflow state",
              "type": "number"
            },
            {
              "selector": "resolution",
              "text": "Last verified resolution",
              "type": "number"
            },
            {
              "selector": "pending_plan",
              "text": "Pending plan",
              "type": "number"
            },
            {
              "selector": "attempts",
              "text": "Failed attempts",
              "type": "number"
            },
            {
              "selector": "notes_delivered",
              "text": "Internal notes delivered",
              "type": "number"
            },
            {
              "selector": "notes_waiting",
              "text": "Internal notes waiting",
              "type": "number"
            },
            {
              "selector": "notes_to_github_delivered",
              "text": "GitHub replies delivered",
              "type": "number"
            },
            {
              "selector": "notes_to_github_waiting",
              "text": "GitHub replies waiting",
              "type": "number"
            },
            {
              "selector": "last_success_ms",
              "text": "Last verified convergence",
              "type": "number"
            },
            {
              "selector": "zendesk_url",
              "text": "zendesk_url",
              "type": "string"
            },
            {
              "selector": "github_url",
              "text": "github_url",
              "type": "string"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Zendesk ticket": 0,
              "GitHub issue": 1,
              "Ticket subject": 2,
              "Workflow state": 3,
              "Last verified resolution": 4,
              "Pending plan": 5,
              "Failed attempts": 6,
              "Internal notes delivered": 7,
              "Internal notes waiting": 8,
              "GitHub replies delivered": 9,
              "GitHub replies waiting": 10,
              "Last verified convergence": 11,
              "zendesk_url": 12,
              "github_url": 13
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "GitHub issue",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not observed",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Zendesk ticket"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Zendesk ticket",
                    "url": "${__data.fields[\"zendesk_url\"]}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GitHub issue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 105
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open GitHub issue",
                    "url": "${__data.fields[\"github_url\"]}",
                    "targetBlank": true
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Workflow state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Ready for sweep",
                        "color": "blue"
                      },
                      "2": {
                        "text": "Synced",
                        "color": "green"
                      },
                      "3": {
                        "text": "Awaiting approval",
                        "color": "orange"
                      },
                      "4": {
                        "text": "Conflict",
                        "color": "red"
                      },
                      "5": {
                        "text": "Retry scheduled",
                        "color": "yellow"
                      },
                      "6": {
                        "text": "Needs intervention",
                        "color": "red"
                      },
                      "7": {
                        "text": "Unknown stored state",
                        "color": "red"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 155
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last verified resolution"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "No verified baseline",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Open",
                        "color": "blue"
                      },
                      "2": {
                        "text": "Resolved",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pending plan"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "None recorded",
                        "color": "gray"
                      },
                      "1": {
                        "text": "Yes",
                        "color": "orange"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed attempts"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last verified convergence"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "noValue",
                "value": "Never verified"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Never verified",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 215
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Internal notes delivered"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Internal notes waiting"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ticket subject"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 270
              },
              {
                "id": "custom.wrapText",
                "value": true
              },
              {
                "id": "noValue",
                "value": "No verified subject"
              },
              {
                "id": "description",
                "value": "Last verified common title/subject. A later source edit may be waiting for the worker or review."
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "zendesk_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "github_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GitHub replies delivered"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "GitHub replies waiting"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Observed linked-pair workflow history",
      "description": "Sampled stored status for all linked mappings since the dynamic projection was introduced. No history is inferred or backfilled; retained legacy case series remain separate.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_linked_pair_status",
          "legendFormat": "Zendesk {{zendesk_ticket}} \u2194 GitHub {{github_issue}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Not observed",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Ready for sweep",
                  "color": "blue"
                },
                "2": {
                  "text": "Synced",
                  "color": "green"
                },
                "3": {
                  "text": "Awaiting approval",
                  "color": "orange"
                },
                "4": {
                  "text": "Conflict",
                  "color": "red"
                },
                "5": {
                  "text": "Retry scheduled",
                  "color": "yellow"
                },
                "6": {
                  "text": "Needs intervention",
                  "color": "red"
                },
                "7": {
                  "text": "Unknown stored state",
                  "color": "red"
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "mergeValues": true,
        "rowHeight": 0.75,
        "showValue": "auto",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Zendesk engineering intake",
      "description": "Actual stored creation intents by fixed state. Linked means an engineering issue was associated, not that the customer problem was resolved. Uncertain creation is never blindly retried.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_intake_records",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "GitHub comments to internal notes",
      "description": "Stored append delivery states. Delivered requires a uniquely observed internal Zendesk note; uncertain is held without blind resend. Discovery errors contribute separately to Operator attention.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_comment_deliveries",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "New Zendesk internal notes to GitHub",
      "description": "First complete scan records a durable starting point without copying history. Subsequent internal notes are delivered once; waiting includes uncertain and blocked work. Starting points recorded counts initialized linked streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "supportbridge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "support_bridge_note_deliveries",
          "legendFormat": "{{status}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "support_bridge_note_streams_initialized",
          "legendFormat": "Starting points recorded",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
