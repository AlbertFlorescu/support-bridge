global:
  scrape_interval: 5s
  evaluation_interval: 5s
rule_files:
  - @RULES_FILE@
scrape_configs:
  - job_name: support_bridge
    metrics_path: /metrics
    scrape_timeout: 3s
    follow_redirects: false
    authorization:
      type: Bearer
      credentials_file: @METRICS_TOKEN_FILE@
    static_configs:
      - targets: [@APP_TARGET@]
